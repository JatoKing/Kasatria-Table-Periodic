# Copy this file to .env.local for local development.
# On Vercel, add the same variables under Project Settings → Environment Variables, then redeploy.

# --- Browser and server -------------------------------------------------------
# Google Cloud → Google Auth Platform → Clients → your Web client.
# Public by design: it identifies the app, it grants nothing on its own.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# --- Server only: never add the NEXT_PUBLIC_ prefix to these ------------------
# From the sheet URL: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
SPREADSHEET_ID=your-spreadsheet-id

# Optional. Tab name and columns in A1 notation. Tab names with spaces need single quotes.
# Defaults to 'Data Template'!A:F. If you renamed the tab to Data, use Data!A:F.
SHEET_RANGE="'Data Template'!A:F"

# From the service account's JSON key file: client_email and private_key.
# Share the sheet with this address as Viewer.
GOOGLE_SERVICE_ACCOUNT_EMAIL=people-reader@your-project.iam.gserviceaccount.com
# Paste private_key exactly as it appears in the JSON file, in double quotes, with its \n sequences.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-key\n-----END PRIVATE KEY-----\n"
